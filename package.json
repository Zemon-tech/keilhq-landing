{
  "name": "Keil-land",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run cms:generate && next dev --webpack",
    "cms:generate": "npx tsx scripts/generate-cms-data.ts",
    "build": "npx tsx scripts/generate-cms-data.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "npx tsx scripts/generate-cms-data.ts && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npx tsx scripts/generate-cms-data.ts && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@keystatic/core": "^0.5.51",
    "@keystatic/next": "^5.0.4",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "framer-motion": "^12.40.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.434.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.95.0"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "patch-package": "^8.0.1"
  }
}
